---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  date: Date;
  description?: string;
  ogImage?: string;
}

const { title, date, description, ogImage } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "2-digit",
});
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <article>
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <time class="post-meta" datetime={date.toISOString()}>
        {formattedDate}
      </time>
    </header>
    <section class="post-content">
      <slot />
    </section>
  </article>
</BaseLayout>
