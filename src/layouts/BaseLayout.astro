---
import sharp from "sharp";
import { resolve, sep } from "node:path";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
}

const { title, description = "the blog and website of Nate Barbettini", ogImage, ogImageAlt, ogType = "website" } = Astro.props;
const siteTitle = "caffeinate";
const isHome = title === siteTitle;
const pageTitle = isHome ? `${siteTitle}, ${description}` : title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site).href : new URL("/img/coffee.png", Astro.site).href;
const imageURL = new URL(ogImageURL);
let imageWidth: number | undefined;
let imageHeight: number | undefined;

// Local public assets are inspected at build time; remote images keep dimensions unspecified.
if (imageURL.origin === Astro.site?.origin) {
  const publicDirectory = resolve("public");
  const imagePath = resolve(publicDirectory, `.${decodeURIComponent(imageURL.pathname)}`);
  if (!imagePath.startsWith(publicDirectory + sep)) throw new Error("Invalid sharing image path");
  const metadata = await sharp(imagePath).metadata();
  imageWidth = metadata.autoOrient.width;
  imageHeight = metadata.autoOrient.height;
}
const largeImage = imageWidth && imageHeight && imageWidth >= 300 && imageHeight >= 157 && imageWidth > imageHeight;
const imageAlt = ogImage ? ogImageAlt : "A cup of coffee";

const navLinks = [
  { title: "about", url: "/about/" },
  { title: "youtube", url: "https://www.youtube.com/playlist?list=PLLRFyxYl_5YjpoPB1ryUbrCM7tmKFUNBV" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Nate Barbettini" />
    {description && <meta name="description" content={description} />}

    <meta name="twitter:card" content={largeImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:creator" content="@nbarbettini" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:image" content={ogImageURL} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {imageWidth && <meta property="og:image:width" content={imageWidth} />}
    {imageHeight && <meta property="og:image:height" content={imageHeight} />}
    {description && <meta property="og:description" content={description} />}

    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
  </head>
  <body>
    <div class="site-wrapper">
      <header class="site-header">
        <h1 class="blog-title">
          <a href="/"><span class="title-light">caffei</span><span class="title-dark">nate</span></a>
        </h1>
        <nav>
          <ul class="site-nav">
            {navLinks.map((link) => (
              <li><a href={link.url}>{link.title}</a></li>
            ))}
          </ul>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <p>
          &copy; {new Date().getFullYear()} &middot; Created with ☕
          by <a href="/about/">Nate Barbettini</a>.
        </p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
