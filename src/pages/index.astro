---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { renderPostPreview } from "../lib/post-preview.mjs";

const posts = (await getCollection("post", ({ data }) => !data.draft && !data.hide))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function readingTime(body: string): string {
  const words = body.split(/\s+/).length;
  const minutes = Math.ceil(words / 200);
  return `${minutes} min read`;
}

const postPreviews = await Promise.all(posts.map(async (post) => {
  const { html, truncated } = await renderPostPreview(post.body ?? "", post.data.postimage);
  return { post, html, truncated };
}));
---

<BaseLayout title="caffeinate">
  <div class="intro">
    <p>
      <strong>Hi, I'm <a href="/about">Nate Barbettini</a>. I write about <a href="/post/mcp-in-plain-english/">MCP</a>, security, and practical architecture.</strong>
    </p>
  </div>

  <ul class="post-list">
    {postPreviews.map(({ post, html, truncated }, i) => (
      <>
        <li class="post-item">
          <header>
            <h2 class="post-title">
              <a href={`/post/${post.id}/`}>{post.data.title}</a>
            </h2>
            <span class="post-meta">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "2-digit",
                })}
              </time>
            </span>
          </header>
          <div class="post-body">
            {post.data.postimage && (
              <img
                src={post.data.postimage}
                alt=""
                class="post-image"
                loading="lazy"
              />
            )}
            <div class="post-excerpt" set:html={html} />
            {truncated && (
              <p class="keep-reading">
                <a href={`/post/${post.id}/`}>keep reading...</a>
                {" "}({readingTime(post.body ?? "")})
              </p>
            )}
          </div>
        </li>
        {i < posts.length - 1 && <hr />}
      </>
    ))}
  </ul>
</BaseLayout>
