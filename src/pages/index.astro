---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { marked } from "marked";

const posts = (await getCollection("post", ({ data }) => !data.draft && !data.hide))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function readingTime(body: string): string {
  const words = body.split(/\s+/).length;
  const minutes = Math.ceil(words / 200);
  return `${minutes} min read`;
}

function getPreviewMarkdown(body: string, postimage?: string): { markdown: string; truncated: boolean } {
  const text = body.replace(/^---[\s\S]*?---\s*/, "");

  // Extract reference link definitions from the full body so they resolve in the preview
  const refDefs = [...text.matchAll(/^\[([^\]]+)\]:\s+.+$/gm)].map((m) => m[0]);

  let preview: string;
  let truncated: boolean;

  // Support <!--more--> marker
  const moreIndex = text.indexOf("<!--more-->");
  if (moreIndex !== -1) {
    preview = text.slice(0, moreIndex).trim();
    truncated = true;
  } else {
    // Split at first ## heading
    const headingMatch = text.match(/^## /m);
    if (headingMatch?.index != null && headingMatch.index > 0) {
      preview = text.slice(0, headingMatch.index).trim();
      truncated = true;
    } else {
      // Short post — show everything
      preview = text.trim();
      truncated = false;
    }
  }

  // Strip images that duplicate the postimage
  if (postimage) {
    preview = preview.replace(new RegExp(`<img[^>]*src=["']${postimage.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}["'][^>]*>`, 'g'), '');
  }

  // Append reference definitions so reference-style links resolve
  if (refDefs.length > 0) {
    preview = preview + "\n\n" + refDefs.join("\n");
  }

  return { markdown: preview.trim(), truncated };
}

const postPreviews = await Promise.all(posts.map(async (post) => {
  const { markdown, truncated } = getPreviewMarkdown(post.body ?? "", post.data.postimage);
  const html = await marked.parse(markdown);
  return { post, html, truncated };
}));
---

<BaseLayout title="recaffeinate">
  <div class="intro">
    <p>
      <strong>Hi, I'm Nate. I write about code, security, and practical architecture.</strong>
    </p>
  </div>

  <hr />

  <ul class="post-list">
    {postPreviews.map(({ post, html, truncated }, i) => (
      <>
        <li class="post-item">
          <header>
            <h2 class="post-title">
              <a href={`/post/${post.id}/`}>{post.data.title}</a>
            </h2>
            <span class="post-meta">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "2-digit",
                })}
              </time>
            </span>
          </header>
          <div class="post-body">
            {post.data.postimage && (
              <img
                src={post.data.postimage}
                alt=""
                class="post-image"
                loading="lazy"
              />
            )}
            <div class="post-excerpt" set:html={html} />
            {truncated && (
              <p class="keep-reading">
                <a href={`/post/${post.id}/`}>keep reading...</a>
                {" "}({readingTime(post.body ?? "")})
              </p>
            )}
          </div>
        </li>
        {i < posts.length - 1 && <hr />}
      </>
    ))}
  </ul>
</BaseLayout>
