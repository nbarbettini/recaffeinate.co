---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("post", ({ data }) => !data.draft && !data.hide))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function readingTime(body: string): string {
  const words = body.split(/\s+/).length;
  const minutes = Math.ceil(words / 200);
  return `${minutes} min read`;
}

function getExcerpt(body: string): string {
  // Strip frontmatter, HTML tags, and markdown formatting, then take first ~200 chars
  const cleaned = body
    .replace(/^---[\s\S]*?---/, "")
    .replace(/<[^>]+>/g, "")
    .replace(/!\[.*?\]\(.*?\)/g, "")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/\[([^\]]+)\]\[[^\]]*\]/g, "$1")
    .replace(/#{1,6}\s+/g, "")
    .replace(/[*_`~]+/g, "")
    .replace(/\n+/g, " ")
    .trim();
  const truncated = cleaned.slice(0, 200);
  const lastSpace = truncated.lastIndexOf(" ");
  return (lastSpace > 150 ? truncated.slice(0, lastSpace) : truncated) + "...";
}
---

<BaseLayout title="recaffeinate">
  <div class="intro">
    <p>
      <strong>Hi, I'm Nate. I write about code, security, and practical architecture.</strong>
    </p>
  </div>

  <hr />

  <ul class="post-list">
    {posts.map((post, i) => (
      <>
        <li class="post-item">
          <header>
            <h2 class="post-title">
              <a href={`/post/${post.id}/`}>{post.data.title}</a>
            </h2>
            <span class="post-meta">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "2-digit",
                })}
              </time>
              {" "}&middot;{" "}
              {readingTime(post.body ?? "")}
            </span>
          </header>
          <div class="post-body">
            {post.data.postimage && (
              <img
                src={post.data.postimage}
                alt=""
                class="post-image"
                loading="lazy"
              />
            )}
            <p class="post-excerpt">{getExcerpt(post.body ?? "")}</p>
          </div>
        </li>
        {i < posts.length - 1 && <hr />}
      </>
    ))}
  </ul>
</BaseLayout>
